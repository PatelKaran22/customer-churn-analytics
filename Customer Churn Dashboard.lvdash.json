{
  "datasets": [
    {
      "name": "ac792201",
      "displayName": "Risk_distribution",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    CASE \n",
        "        WHEN churn_probability >= 0.7 THEN 'High Risk'\n",
        "        WHEN churn_probability >= 0.4 THEN 'Medium Risk'\n",
        "        ELSE 'Low Risk'\n",
        "    END AS risk_segment,\n",
        "    COUNT(*) AS customers\n",
        "FROM workspace.default.churn_predictions\n",
        "GROUP BY risk_segment;"
      ]
    },
    {
      "name": "523c8495",
      "displayName": "geo_churn",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    Geography,\n",
        "    ROUND(AVG(churn_probability), 1) AS churn_rate_pct,\n",
        "    COUNT(*) AS customers\n",
        "FROM workspace.default.churn_predictions\n",
        "GROUP BY Geography\n",
        "ORDER BY churn_rate_pct DESC;"
      ]
    },
    {
      "name": "23c3e986",
      "displayName": "product_churn",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    NumOfProducts,\n",
        "    ROUND(AVG(churn_probability) * 100, 1) AS churn_rate_pct,\n",
        "    COUNT(*) AS customers\n",
        "FROM workspace.default.churn_predictions\n",
        "GROUP BY NumOfProducts\n",
        "ORDER BY churn_rate_pct DESC;"
      ]
    },
    {
      "name": "0dc7b1bb",
      "displayName": "high_risk_customers",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    CustomerId,\n",
        "    Geography,\n",
        "    Balance,\n",
        "    NumOfProducts,\n",
        "    IsActiveMember,\n",
        "    ROUND(churn_probability * 100, 1) AS churn_risk_pct\n",
        "FROM workspace.default.churn_predictions\n",
        "WHERE churn_probability >= 0.7\n",
        "ORDER BY churn_risk_pct DESC;"
      ]
    },
    {
      "name": "d3ae1b10",
      "displayName": "revenue_risk",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    ROUND(SUM(Balance), 2) AS total_balance,\n",
        "    ROUND(SUM(CASE WHEN churn_probability >= 0.7 THEN Balance ELSE 0 END), 2) AS high_risk_balance\n",
        "FROM workspace.default.churn_predictions;"
      ]
    },
    {
      "name": "dbe9d1f1",
      "displayName": "revenue_risk",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    ROUND(SUM(Balance), 2) AS total_balance,\n",
        "    ROUND(SUM(CASE WHEN churn_probability >= 0.7 THEN Balance ELSE 0 END), 2) AS high_risk_balance\n",
        "FROM workspace.default.churn_predictions;"
      ]
    },
    {
      "name": "96886e44",
      "displayName": "revenue_risk(%)",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    ROUND(\n",
        "        100 * SUM(CASE WHEN churn_probability >= 0.7 THEN Balance ELSE 0 END) \n",
        "        / SUM(Balance), \n",
        "    2) AS revenue_at_risk_pct\n",
        "FROM workspace.default.churn_predictions;"
      ]
    },
    {
      "name": "14af0a7a",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "-- Query 1: KPI\n",
        "SELECT \n",
        "    COUNT(*) AS total_customers,\n",
        "    SUM(CASE WHEN churn_probability >= 0.7 THEN 1 ELSE 0 END) AS high_risk_customers,\n",
        "    ROUND(AVG(churn_probability) * 100, 1) AS avg_churn_probability_pct\n",
        "FROM workspace.default.churn_predictions;"
      ]
    }
  ],
